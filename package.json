{
	"name": "pelican-arena",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply pelican-arena --local",
		"db:migrate:remote": "wrangler d1 migrations apply pelican-arena --remote",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"isbot": "^5.1.36",
		"lucide-react": "^1.63.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.66.0",
		"@react-router/dev": "^8.5.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	}
}
