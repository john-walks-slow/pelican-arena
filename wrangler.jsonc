/**
 * Pelican Arena. One Worker serves both the main site and, on a separate
 * registrable domain, the user-submitted pages (see workers/app.ts).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pelican-arena",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"vars": {
		"APP_ORIGIN": "https://pelicanarena.dpdns.org",
		"USERCONTENT_ORIGIN": "https://pelicanarena.elsewhere.dpdns.org",
		"LINUXDO_CLIENT_ID": "WEeAp0GneHGJhKT3jWhtSnMPAFhs7BH4",
		"ADMIN_USERNAMES": "JohnnRen",
		// New prompts publish immediately; set to "true" to review them first.
		"PROMPT_REVIEW": "false",
		"RENDER_ORIGIN": "https://render.johnnren.qzz.io"
	},
	"routes": [
		{ "pattern": "pelicanarena.dpdns.org", "custom_domain": true },
		{ "pattern": "pelicanarena.elsewhere.dpdns.org", "custom_domain": true }
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "pelican-arena-files"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pelican-arena-apac",
			"database_id": "caf789bc-63ed-42dc-afc0-3a34b6930dbd",
			"migrations_dir": "drizzle"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"upload_source_maps": true
}
